# CamWall shared environment
#
# Copy this to /opt/camwall/camwall.env for systemd services and to
# /opt/camwall/.env for Docker Compose/go2rtc.

TZ=Australia/Sydney

# Camera ONVIF/RTSP account. Create this account in the camera vendor app.
ONVIF_USER=camwall
ONVIF_PASS=change-me

# TP-Link Tapo cloud password. Needed only for Tapo OSD/talk helpers.
TAPO_PASS=

# Optional canonical HTTPS URL. When set, direct HTTP backend hits redirect here.
CAMWALL_PUBLIC_URL=
