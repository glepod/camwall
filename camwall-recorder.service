[Unit]
Description=CamWall Recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ziggy
WorkingDirectory=/opt/camwall/recorder
Environment=CAMWALL_RECORDER_PORT=8091
EnvironmentFile=-/opt/camwall/camwall.env
EnvironmentFile=-/opt/camwall/recorder.env
ExecStart=/usr/bin/python3 /opt/camwall/recorder/recorder.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
